---

<footer class="bg-[#3B3938] text-white/70 pt-16" id="footer">
  <div class="max-w-[1200px] mx-auto px-6 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-12 pb-12 items-start">
    <!-- Brand -->
    <div>
      <div class="mb-3 group w-fit">
        <img
          src="/images/citroen-logo.svg"
          alt="Citroën"
          width="140"
          height="35"
          class="h-6 w-auto site-logo site-logo--invert"
          loading="lazy"
          decoding="async"
        />
      </div>
      <p class="text-sm text-white/40 max-w-[280px]">Berlingo Van — Diseñada para mover tu negocio.</p>

      <!-- Social Media -->
      <div class="flex items-center gap-4 mt-6">
        {socialLinks.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Citroën Colombia en ${social.name}`}
            class="w-8 h-8 flex items-center justify-center text-white/40 hover:text-white transition-colors duration-200"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="w-5 h-5">
              <Fragment set:html={social.icon} />
            </svg>
          </a>
        ))}
      </div>
    </div>

    <!-- Links -->
    <div>
      <h4 class="text-[11px] font-bold uppercase tracking-[0.15em] text-white/35 mb-4">Legal</h4>
      <a href="/docs/MANUAL%20DE%20CUMPLIMIENTO%20PROGRAMA%20DE%20TRANSPARENCIA%20Y%20ETICA%20EMPRESARIAL.pdf" target="_blank" rel="noopener noreferrer" class="block text-sm text-white/60 mb-2.5 hover:text-[#da281c] transition-colors">Manual de Cumplimiento Programa de Transparencia y Etica Empresarial</a>
      <a href="/docs/POLITICA%20INSTITUCIONAL%20DE%20TRATAMIENTO%20Y%20USO%20DE%20DATOS%20E%20INFORMACION%20PERSONAL.pdf" target="_blank" rel="noopener noreferrer" class="block text-sm text-white/60 mb-2.5 hover:text-[#da281c] transition-colors">Politica Institucional de Tratamiento y Uso de Datos e Informacion Personal</a>
      <a href="/docs/COMPLIANCE%20MANUAL%20TRANSPARENCY%20AND%20BUSINESS%20ETHICS%20PROGRAM.pdf" target="_blank" rel="noopener noreferrer" class="block text-sm text-white/60 mb-2.5 hover:text-[#da281c] transition-colors">Compliance Manual Transparency and Business Ethics Program</a>
      <a href="/docs/SAGRILAFT.pdf" target="_blank" rel="noopener noreferrer" class="block text-sm text-white/60 mb-2.5 hover:text-[#da281c] transition-colors">SAGRILAFT</a>

    </div>

  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/8 py-6">
    <div class="max-w-[1200px] mx-auto px-6 flex flex-col md:flex-row md:justify-between md:items-center gap-2">
      <p class="text-xs text-white/30">&copy; {year} Citroën. Todos los derechos reservados.</p>
      <p class="text-[11px] text-white/25">
        Las fotografías e información presentadas son de carácter referencial. Consulta con tu concesionario autorizado.
      </p>
    </div>
  </div>
</footer>
