---
// Lightbox.astro — Fullscreen image overlay component
---

<!-- Lightbox Overlay -->
<div id="lightbox" class="fixed inset-0 z-[9999] bg-black/90 backdrop-blur-sm hidden items-center justify-center p-4 md:p-8 cursor-zoom-out" role="dialog" aria-modal="true" aria-label="Imagen ampliada">
  <!-- Close Button -->
  <button id="lightbox-close" class="absolute top-6 right-6 w-12 h-12 flex items-center justify-center text-white/70 hover:text-white transition-colors z-10" aria-label="Cerrar imagen">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>

  <!-- Navigation Arrows -->
  <button id="lightbox-prev" class="absolute left-4 md:left-8 top-1/2 -translate-y-1/2 w-12 h-12 flex items-center justify-center text-white/50 hover:text-white transition-colors" aria-label="Imagen anterior">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"/>
    </svg>
  </button>
  <button id="lightbox-next" class="absolute right-4 md:right-8 top-1/2 -translate-y-1/2 w-12 h-12 flex items-center justify-center text-white/50 hover:text-white transition-colors" aria-label="Imagen siguiente">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6"/>
    </svg>
  </button>

  <!-- Image Container — two stacked imgs for cross-fade -->
  <div id="lb-img-wrap" class="relative max-w-5xl w-full flex items-center justify-center" style="height:min(85vh,800px);">
    <img id="lb-a" src="" alt="" class="absolute inset-0 m-auto max-w-full max-h-full object-contain select-none" style="transition:opacity 0.45s ease;" />
    <img id="lb-b" src="" alt="" class="absolute inset-0 m-auto max-w-full max-h-full object-contain select-none" style="opacity:0;transition:opacity 0.45s ease;" />
    <!-- Full-width gradient covering the bottom of the rendered image area -->
    <div id="lb-gradient" aria-hidden="true" style="position:absolute;z-index:9;pointer-events:none;background:linear-gradient(to top,rgba(0,0,0,0.62) 0%,rgba(0,0,0,0.18) 60%,rgba(0,0,0,0) 100%);"></div>
    <!-- Badge content (no background) pinned over gradient by JS -->
    <div id="lb-badge" class="img-ref-badge" aria-hidden="true" style="position:absolute;z-index:10;pointer-events:none;background:none;">
      <img src="/images/svg/ICONOS.svg" alt="" loading="lazy" decoding="async" width="180" />
      <p>La imagen es de referencia.</p>
    </div>
  </div>

  <!-- Counter -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 text-center">
    <p id="lightbox-counter" class="text-xs text-white/30"></p>
  </div>
</div>

<script>
  const lightbox   = document.getElementById('lightbox')!;
  const lbWrap     = document.getElementById('lb-img-wrap')!;
  const lbBadge    = document.getElementById('lb-badge')!;
  const lbGradient = document.getElementById('lb-gradient')!;
  const lbCounter  = document.getElementById('lightbox-counter')!;
  const lbClose    = document.getElementById('lightbox-close')!;
  const lbPrev     = document.getElementById('lightbox-prev')!;
  const lbNext     = document.getElementById('lightbox-next')!;
  const imgA       = document.getElementById('lb-a') as HTMLImageElement;
  const imgB       = document.getElementById('lb-b') as HTMLImageElement;

  let currentIndex = 0;
  let front: HTMLImageElement = imgA;
  let back:  HTMLImageElement = imgB;
  let transitioning = false;
  let images: { src: string; alt: string; label: string }[] = [];

  // Compute where object-contain places the image inside the container,
  // then pin the badge to the bottom-left corner of that rendered rect.
  function repositionBadge(img: HTMLImageElement) {
    const nW = img.naturalWidth;
    const nH = img.naturalHeight;
    if (!nW || !nH) return;
    const cW = lbWrap.clientWidth;
    const cH = lbWrap.clientHeight;
    const imgAspect = nW / nH;
    const cAspect   = cW / cH;
    let renderW: number, renderH: number, offsetX: number, offsetY: number;
    if (imgAspect > cAspect) {
      renderW = cW;  renderH = cW / imgAspect;
      offsetX = 0;   offsetY = (cH - renderH) / 2;
    } else {
      renderH = cH;  renderW = cH * imgAspect;
      offsetX = (cW - renderW) / 2;  offsetY = 0;
    }
    // Gradient: full width of rendered image, bottom 38%
    const gradH = renderH * 0.38;
    lbGradient.style.left   = `${offsetX}px`;
    lbGradient.style.width  = `${renderW}px`;
    lbGradient.style.height = `${gradH}px`;
    lbGradient.style.bottom = `${cH - offsetY - renderH}px`;
    lbGradient.style.top    = 'auto';
    // Badge: pinned bottom-left inside rendered image
    lbBadge.style.left   = `${offsetX + 10}px`;
    lbBadge.style.bottom = `${cH - offsetY - renderH + 10}px`;
    lbBadge.style.top    = 'auto';
  }

  function initLightbox() {
    const triggers = document.querySelectorAll('[data-lightbox]');
    images = Array.from(triggers).map((el) => ({
      src:   el.getAttribute('data-src') || (el as HTMLImageElement).src || '',
      alt:   (el as HTMLImageElement).alt || '',
      label: el.getAttribute('data-label') || '',
    }));
    triggers.forEach((el, idx) => {
      el.addEventListener('click', () => openLightbox(idx));
      (el as HTMLElement).style.cursor = 'zoom-in';
    });
  }

  function openLightbox(index: number) {
    currentIndex = index;
    const img = images[index];
    front.src = img.src;
    front.alt = img.alt;
    front.style.opacity = '1';
    back.style.opacity  = '0';
    lbCounter.textContent = `${index + 1} / ${images.length}`;
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
    // Reposition once image dimensions are available
    if (front.complete && front.naturalWidth) {
      repositionBadge(front);
    } else {
      front.onload = () => repositionBadge(front);
    }
  }

  function closeLightbox() {
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
  }

  function goTo(index: number) {
    if (transitioning) return;
    transitioning = true;
    currentIndex = index;
    const img = images[index];
    lbCounter.textContent = `${index + 1} / ${images.length}`;

    back.alt = img.alt;
    back.style.opacity = '0';
    const preload = new Image();
    preload.onload = preload.onerror = () => {
      back.src = img.src;
      void back.offsetWidth;
      front.style.opacity = '0';
      back.style.opacity  = '1';
      setTimeout(() => {
        [front, back] = [back, front];
        // front is now the newly visible image — reposition badge
        if (front.naturalWidth) repositionBadge(front);
        else front.onload = () => repositionBadge(front);
        transitioning = false;
      }, 460);
    };
    preload.src = img.src;
  }

  function showPrev() { goTo((currentIndex - 1 + images.length) % images.length); }
  function showNext() { goTo((currentIndex + 1) % images.length); }

  lbClose.addEventListener('click', closeLightbox);
  lbPrev.addEventListener('click', (e) => { e.stopPropagation(); showPrev(); });
  lbNext.addEventListener('click', (e) => { e.stopPropagation(); showNext(); });
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
  document.addEventListener('keydown', (e) => {
    if (lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape')     closeLightbox();
    if (e.key === 'ArrowLeft')  showPrev();
    if (e.key === 'ArrowRight') showNext();
  });
  window.addEventListener('resize', () => repositionBadge(front));

  // Touch swipe support
  let touchStartX = 0;
  lightbox.addEventListener('touchstart', (e) => { touchStartX = e.changedTouches[0].clientX; }, { passive: true });
  lightbox.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 40) dx < 0 ? showNext() : showPrev();
  }, { passive: true });

  initLightbox();
</script>
