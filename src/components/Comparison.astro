---
// Comparison.astro — Versiones: 1 puerta lateral vs doble puerta lateral
import ResponsiveImage from './ResponsiveImage.astro';
const base = import.meta.env.BASE_URL;

const models = [
  {
    name: 'Berlingo 1 Puerta Lateral',
    description: 'Configuración estándar con una puerta lateral corrediza. Ideal para operaciones de carga y descarga en espacios reducidos.',
    image: 'FOTOS BERLINGO/seccion versiones/1 puerta lateral.webp',
    recommended: false,
  },
  {
    name: 'Berlingo Doble Puerta Lateral',
    description: 'Doble acceso lateral para máxima versatilidad en carga y descarga, optimizando los tiempos de tu operación.',
    image: 'FOTOS BERLINGO/seccion versiones/doble puerta lateral.webp',
    recommended: false,
  },
];

const colors = [
  { name: 'Blanco', hex: '#FFFFFF', border: true },
];
---

<section class="py-20 bg-white" id="comparison">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="text-center max-w-3xl mx-auto mb-16" data-reveal="fade-up">
      <span class="inline-block px-3 py-1 mb-6 text-[10px] font-bold uppercase tracking-[0.15em] text-[#da281c] border border-[#da281c] border-opacity-30 border-solid rounded-sm">Versiones</span>
      <h2 class="text-[clamp(2rem,3.5vw,3rem)] leading-[1.1] font-bold text-[#3B3938] mb-6">
        Elige la Berlingo que mejor<br class="md:hidden"/> se adapta a tu operación
      </h2>
    </div>

    <!-- Models Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      {models.map((model, i) => (
        <div class={`border rounded-lg overflow-hidden transition-all duration-300 hover:shadow-lg hover:border-[#da281c] ${model.recommended ? 'border-[#da281c] ring-2 ring-[#da281c]/15 relative' : 'border-[#E7E7E7]'}`} data-reveal="fade-up" style={`--reveal-delay: ${i * 0.15}s`}>
          {model.recommended && (
            <div class="absolute top-4 right-4 z-10">
              <span class="px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-white bg-[#da281c] rounded-full">Recomendado</span>
            </div>
          )}

          <!-- Image -->
          <div class="version-img-wrap h-[300px] bg-[#F5F6F7] flex items-center justify-center relative overflow-hidden">
            <ResponsiveImage
              src={model.image}
              alt={model.name}
              class="w-full h-full object-cover"
              sizes="(min-width: 768px) 50vw, 100vw"
              widths={[480, 800, 1200]}
            />
          </div>

          <!-- Content -->
          <div class="p-8">
            <h3 class="text-xl font-bold text-[#3B3938] uppercase mb-3">{model.name}</h3>
            <p class="text-[14px] text-[#646464] leading-relaxed mb-6">{model.description}</p>
            <a href="#hero" data-version={i === 0 ? '1-puerta' : 'doble-puerta'} class={`version-cotizar w-full ${model.recommended ? 'btn-primary' : 'btn-outline-dark'}`}>
              Cotizar
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Colors -->
    <div class="text-center mb-12">
      <h3 class="text-lg font-bold text-[#3B3938] uppercase mb-4">Colores disponibles</h3>
      <div class="flex justify-center gap-4">
        {colors.map((color) => (
          <div class="flex flex-col items-center gap-2">
            <div class={`w-12 h-12 rounded-full ${color.border ? 'border-2 border-[#E7E7E7]' : ''}`} style={`background-color: ${color.hex}`}></div>
            <span class="text-[13px] text-[#646464] font-bold">{color.name}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Dimensions Box (estilo ficha con silueta + medidas) -->
    <div class="bg-white border border-[#E7E7E7] rounded-lg p-8 lg:p-10" data-reveal="fade-up">
      <h3 class="text-lg font-bold text-[#3B3938] uppercase mb-6 text-center">Dimensiones exteriores</h3>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">

        <!-- Silueta -->
        <div class="flex items-center justify-center relative">
          <ResponsiveImage
            src="FOTOS BERLINGO/seccion caracteristicas/berlingo.png"
            alt="Silueta Citroën Berlingo"
            class="max-h-[180px] w-auto object-contain"
            widths={[480]}
            sizes="(min-width: 1024px) 40vw, 80vw"
            loading="lazy"
            showBadge={false}
          />
        </div>

        <!-- Medidas -->
        <div class="grid grid-cols-3 gap-3">
          <div class="bg-[#F8F9FA] border border-[#E7E7E7] rounded-md py-3 px-1.5 sm:py-5 sm:px-3 text-center">
            <p class="text-[10px] sm:text-[11px] text-[#646464] uppercase tracking-[0.08em] font-bold mb-2">Longitud total</p>
            <div class="text-[1rem] sm:text-[1.4rem] md:text-[1.75rem] font-bold text-[#da281c] leading-none"><span class="counter" data-counter-target="4753" data-counter-decimals="0" data-counter-thousands=".">0</span><span class="text-xs sm:text-sm text-[#3B3938] ml-1">mm</span></div>
          </div>
          <div class="bg-[#F8F9FA] border border-[#E7E7E7] rounded-md py-3 px-1.5 sm:py-5 sm:px-3 text-center">
            <p class="text-[10px] sm:text-[11px] text-[#646464] uppercase tracking-[0.08em] font-bold mb-2">Altura total</p>
            <div class="text-[1rem] sm:text-[1.4rem] md:text-[1.75rem] font-bold text-[#da281c] leading-none"><span class="counter" data-counter-target="1860" data-counter-decimals="0" data-counter-thousands=".">0</span><span class="text-xs sm:text-sm text-[#3B3938] ml-1">mm</span></div>
          </div>
          <div class="bg-[#F8F9FA] border border-[#E7E7E7] rounded-md py-3 px-1.5 sm:py-5 sm:px-3 text-center">
            <p class="text-[10px] sm:text-[11px] text-[#646464] uppercase tracking-[0.08em] font-bold mb-2">Ancho total</p>
            <div class="text-[1rem] sm:text-[1.4rem] md:text-[1.75rem] font-bold text-[#da281c] leading-none"><span class="counter" data-counter-target="1921" data-counter-decimals="0" data-counter-thousands=".">0</span><span class="text-xs sm:text-sm text-[#3B3938] ml-1">mm</span></div>
          </div>
        </div>
      </div>

      <!-- Capacidades internas -->
      <div class="mt-8 pt-8 border-t border-[#E7E7E7] grid grid-cols-2 md:grid-cols-4 gap-6">
        <div class="text-center">
          <div class="text-[1.75rem] font-bold text-[#3B3938] leading-none mb-1"><span class="counter" data-counter-target="4.4" data-counter-decimals="1" data-counter-decimal-sep=",">0</span><span class="text-base text-[#da281c] font-bold ml-1">m³</span></div>
          <p class="text-[11px] text-[#646464] uppercase tracking-wide font-bold">Volumen de carga</p>
        </div>
        <div class="text-center">
          <div class="text-[1.75rem] font-bold text-[#3B3938] leading-none mb-1"><span class="counter" data-counter-target="3.44" data-counter-decimals="2" data-counter-decimal-sep=",">0</span><span class="text-base text-[#da281c] font-bold ml-1">m</span></div>
          <p class="text-[11px] text-[#646464] uppercase tracking-wide font-bold">Longitud de carga</p>
        </div>
        <div class="text-center">
          <div class="text-[1.75rem] font-bold text-[#3B3938] leading-none mb-1"><span class="counter" data-counter-target="1000" data-counter-decimals="0" data-counter-thousands=".">0</span><span class="text-base text-[#da281c] font-bold ml-1">kg</span></div>
          <p class="text-[11px] text-[#646464] uppercase tracking-wide font-bold">Carga útil</p>
        </div>
        <div class="text-center">
          <div class="text-[1.75rem] font-bold text-[#3B3938] leading-none mb-1"><span class="counter" data-counter-target="3" data-counter-decimals="0">0</span><span class="text-base text-[#da281c] font-bold ml-1">plazas</span></div>
          <p class="text-[11px] text-[#646464] uppercase tracking-wide font-bold">Incluido conductor</p>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  // Animated counters: when a .counter enters viewport, count from 0 to target.
  function formatValue(value: number, decimals: number, decimalSep: string, thousands: string) {
    const fixed = value.toFixed(decimals);
    const [intPart, decPart] = fixed.split('.');
    let intFmt = intPart;
    if (thousands) {
      intFmt = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, thousands);
    }
    return decimals > 0 ? `${intFmt}${decimalSep}${decPart}` : intFmt;
  }

  const counters = document.querySelectorAll<HTMLElement>('.counter');
  const animate = (el: HTMLElement) => {
    if (el.dataset.counted === '1') return;
    el.dataset.counted = '1';
    const target = parseFloat(el.dataset.counterTarget || '0');
    const decimals = parseInt(el.dataset.counterDecimals || '0', 10);
    const decimalSep = el.dataset.counterDecimalSep || '.';
    const thousands = el.dataset.counterThousands || '';
    const duration = 1600;
    const start = performance.now();
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

    const tick = (now: number) => {
      const elapsed = now - start;
      const t = Math.min(elapsed / duration, 1);
      const value = target * easeOut(t);
      el.textContent = formatValue(value, decimals, decimalSep, thousands);
      if (t < 1) requestAnimationFrame(tick);
      else el.textContent = formatValue(target, decimals, decimalSep, thousands);
    };
    requestAnimationFrame(tick);
  };

  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 }
    );
    counters.forEach((c) => io.observe(c));
  } else {
    counters.forEach((c) => animate(c));
  }

  // Wire "Cotizar" buttons to pre-select the matching version in the hero form
  document.querySelectorAll<HTMLAnchorElement>('a.version-cotizar[data-version]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const version = btn.dataset.version as string;
      const versionSelect = document.getElementById('hero-version') as HTMLSelectElement | null;
      if (!versionSelect) return;
      // Handle both raw <select> and Tom Select wrapper
      const tsInstance = (versionSelect as any).tomselect;
      if (tsInstance) {
        tsInstance.setValue(version, false);
      } else {
        versionSelect.value = version;
      }
    });
  });
</script>
