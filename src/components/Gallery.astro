---
// Gallery.astro — Bento grid gallery with lightbox support
import ResponsiveImage from './ResponsiveImage.astro';

// src se pasa relativo a /public/images (sin prefijo "images/")
const folder = "FOTOS BERLINGO/";
const p = (name: string) => folder + name;

const images = [
  // Row 1 (4-col: 2+1+1 | 3-col: 2+1)
  {
    src: p("PHOTO- Vista lateral.webp"),
    alt: "Citroën Berlingo Van - Vista lateral completa",
    label: "Vista lateral",
    wide: true,
  },
  {
    src: p("PHOTO- foto frontal desde un lado derecho completa.webp"),
    alt: "Citroën Berlingo Van - Vista frontal desde el lado derecho",
    label: "Frontal derecha",
    wide: false,
  },
  {
    src: p("PHOTO- foto frontal desde un lado derecho ubicando la van a la izquierda.webp"),
    alt: "Citroën Berlingo Van - Diagonal frontal derecha",
    label: "Diagonal frontal",
    wide: false,
  },
  // Row 2 (4-col: 1+1+1+1 | 3-col: 1+1+1)
  {
    src: p("PHOTO- vista trasera con las puertas abiertas.webp"),
    alt: "Acceso de carga con puertas traseras abiertas",
    label: "Carga trasera",
    wide: false,
  },
  {
    src: p("PHOTO- vista trasera con las puertas abiertas angulo derecho.webp"),
    alt: "Vista trasera con puertas abiertas ángulo derecho",
    label: "Trasera ángulo",
    wide: false,
  },
  {
    src: p("PHOTO- vista trasera cabina de cargawebp.webp"),
    alt: "Compartimiento trasero - cabina de carga",
    label: "Cabina de carga",
    wide: false,
  },
  {
    src: p("vista del volante con todo le panel delantero.webp"),
    alt: "Volante y panel delantero completo",
    label: "Panel delantero",
    wide: false,
  },
  // Row 3 (4-col: 1+1+1+1 | 3-col: 1+1+1)
  {
    src: p("vista del timon y emblema.webp"),
    alt: "Timón y emblema Citroën",
    label: "Timón y emblema",
    wide: false,
  },
  {
    src: p("Panel de control radio.webp"),
    alt: "Panel de control de radio y multimedia",
    label: "Radio",
    wide: false,
  },
  {
    src: p("logo emplema citroen.webp"),
    alt: "Emblema Citroën en la carrocería",
    label: "Emblema Citroën",
    wide: false,
  },
  {
    src: p("Luz  farola frontal derecha.webp"),
    alt: "Faro delantero derecho",
    label: "Faro derecho",
    wide: false,
  },
  // Row 4
  {
    src: p("Luz farola, y rueda frontal izquierda.webp"),
    alt: "Faro y rueda frontal izquierda",
    label: "Faro + rueda izq.",
    wide: false,
  },
  {
    src: p("Rueda Berlingo van.webp"),
    alt: "Neumático y llanta Berlingo Van",
    label: "Rueda",
    wide: false,
  },
];
---

<section class="py-20 bg-[#F5F6F7]" id="gallery">
  <div class="max-w-[1200px] mx-auto px-6">
    <h2
      class="text-[clamp(1.75rem,4vw,2.5rem)] text-[#3B3938] text-center mb-3 uppercase font-bold"
      data-reveal="fade-up"
    >
      Galería Berlingo Van
    </h2>
    <p
      class="text-[17px] text-[#646464] text-center max-w-[600px] mx-auto mb-12 leading-relaxed font-normal normal-case"
      data-reveal="fade-up"
      style="--reveal-delay: 0.1s"
    >
      Conoce la Berlingo Van desde cada ángulo. Haz clic en cualquier
      imagen para ampliarla.
    </p>

    <!-- Gallery grid with collapse -->
    <div class="relative">
      <div id="gallery-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 [grid-auto-flow:dense] gap-3 overflow-hidden" style="max-height: 620px;">
        {
          images.map((img) => (
            <figure
              class={`relative overflow-hidden group ${img.wide ? "sm:col-span-2" : ""}`}
            >
              <div
                class={`relative overflow-hidden rounded-lg bg-[#E7E7E7] ${img.wide ? "aspect-[21/9] sm:aspect-[21/9]" : "aspect-[16/10]"} lg:aspect-auto lg:h-[260px]`}
              >
                <ResponsiveImage
                  src={img.src}
                  alt={img.alt}
                  label={img.label}
                  lightbox={true}
                  sizes="(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw"
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 cursor-zoom-in"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent flex items-end justify-between p-5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
                  <span class="text-[13px] font-bold uppercase tracking-[0.12em] text-white px-4 py-1.5 border border-white/40">
                    {img.label}
                  </span>
                  <svg
                    class="w-6 h-6 text-white/70"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    <line x1="11" y1="8" x2="11" y2="14" />
                    <line x1="8" y1="11" x2="14" y2="11" />
                  </svg>
                </div>
              </div>
            </figure>
          ))
        }
      </div>

      <!-- Gradient fade to bg color -->
      <div id="gallery-fade" class="absolute bottom-0 left-0 right-0 h-52 bg-gradient-to-t from-[#F5F6F7] via-[#F5F6F7]/80 to-transparent pointer-events-none"></div>

      <!-- Show more button -->
      <div id="gallery-expand-wrap" class="absolute bottom-4 left-0 right-0 flex justify-center z-10">
        <button id="gallery-expand-btn" class="btn-primary gap-2 shadow-lg">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          Ver todas las fotos
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById('gallery-expand-btn');
  const grid = document.getElementById('gallery-grid');
  const fade = document.getElementById('gallery-fade');
  const wrap = document.getElementById('gallery-expand-wrap');

  btn?.addEventListener('click', () => {
    if (!grid || !fade || !wrap) return;
    // Animate max-height smoothly
    grid.style.transition = 'max-height 0.8s ease';
    grid.style.maxHeight = grid.scrollHeight + 'px';
    fade.style.transition = 'opacity 0.4s ease';
    fade.style.opacity = '0';
    setTimeout(() => {
      fade.style.display = 'none';
      wrap.style.display = 'none';
      grid.style.maxHeight = 'none';
      grid.style.overflow = 'visible';
    }, 800);
  });
</script>
