---
// Safety.astro — Servicio Posventa section
import PrivacyConsent from './PrivacyConsent.astro';
const base = import.meta.env.BASE_URL;

const services = [
  {
    icon: 'tools',
    title: 'Respaldo real para tu operación',
    items: [
      'Red de talleres especializados',
      'Técnicos certificados',
      'Atención prioritaria para vehículos de trabajo',
    ],
  },
  {
    icon: 'parts',
    title: 'Repuestos disponibles',
    items: [
      'Stock de repuestos originales',
      'Menores tiempos de espera',
      'Soporte continuo para tu operación',
    ],
  },
  {
    icon: 'maintenance',
    title: 'Mantenimiento eficiente',
    items: [
      'Planes de mantenimiento programado',
      'Optimización de tiempos en taller',
      'Mayor vida útil del vehículo',
    ],
  },
  {
    icon: 'support',
    title: 'Acompañamiento constante',
    items: [
      'Asesoría posventa personalizada',
      'Seguimiento de tu vehículo',
      'Soporte para flotas y empresas',
    ],
  },
];
---

<section class="py-24 bg-[#111111] text-white" id="posventa">
  <div class="max-w-[1200px] mx-auto px-6">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16" data-reveal="fade-up">
      <h2 class="text-[clamp(2rem,4vw,3rem)] leading-[1.1] font-bold text-white mb-4">
        Servicio Posventa
      </h2>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      {services.map((service, i) => (
        <div class="bg-white/5 border border-white/10 rounded-lg p-7 hover:border-[#da281c]/40 transition-colors duration-300 group" data-reveal="fade-up" style={`--reveal-delay: ${i * 0.1}s`}>
          <!-- Icon -->
          <div class="w-12 h-12 rounded-full bg-[#da281c]/10 flex items-center justify-center mb-5">
            {service.icon === 'tools' && (
              <!-- lucide:wrench -->
              <svg class="w-6 h-6 text-[#da281c]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            )}
            {service.icon === 'parts' && (
              <!-- lucide:cog -->
              <svg class="w-6 h-6 text-[#da281c]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16Z"/><path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
            )}
            {service.icon === 'maintenance' && (
              <!-- lucide:calendar-clock -->
              <svg class="w-6 h-6 text-[#da281c]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 7.5V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3.5"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h5"/><path d="M17.5 17.5 16 16.3V14"/><circle cx="16" cy="16" r="6"/></svg>
            )}
            {service.icon === 'support' && (
              <!-- lucide:headset -->
              <svg class="w-6 h-6 text-[#da281c]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11a9 9 0 0 1 18 0v6a3 3 0 0 1-3 3h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h4"/><path d="M3 11v6a3 3 0 0 0 3 3h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3"/></svg>
            )}
          </div>

          <h3 class="text-[15px] font-bold text-white uppercase mb-4">{service.title}</h3>
          <ul class="space-y-2.5">
            {service.items.map((item) => (
              <li class="flex items-start gap-2.5 text-[13px] text-white/60 leading-relaxed">
                <svg class="w-3.5 h-3.5 text-[#da281c] mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Dual Form Area: Agenda cita + Pregunta repuestos -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <!-- Agenda Cita -->
      <div class="bg-white/5 border border-white/10 rounded-lg p-8" data-reveal="fade-left">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-10 h-10 rounded-full bg-[#da281c] flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div>
            <h3 class="text-[18px] font-bold text-white uppercase leading-tight">Agenda tu cita</h3>
            <p class="text-[12px] text-white/50">Mantenimiento y servicio técnico</p>
          </div>
        </div>
        <form class="posventa-form" data-form="cita">
          <div class="grid grid-cols-2 gap-3 mb-3">
            <input type="text" name="firstname" class="pv-input" placeholder="Nombres" required />
            <input type="text" name="lastname" class="pv-input" placeholder="Apellidos" required />
          </div>
          <input type="email" name="email" class="pv-input mb-3" placeholder="Email" required />
          <input type="tel" name="phone" class="pv-input mb-3" placeholder="Número de teléfono" required />
          <div class="grid grid-cols-2 gap-3 mb-3">
            <select name="document_type" class="pv-input" required>
              <option value="">Tipo de documento</option>
              <option value="CC">Cédula de ciudadanía</option>
              <option value="CE">Cédula de extranjería</option>
              <option value="NIT">NIT</option>
              <option value="PA">Pasaporte</option>
            </select>
            <input type="text" name="document_number" class="pv-input" placeholder="Documento de identidad" required />
          </div>
          <div class="grid grid-cols-2 gap-3 mb-3">
            <select name="city" id="cita-city" class="pv-input" required>
              <option value="">Ciudad</option>
              <option>Barranquilla</option>
              <option>Bogotá</option>
              <option>Bucaramanga</option>
              <option>Cali</option>
              <option>Cartagena</option>
              <option>Chía</option>
              <option>Cúcuta</option>
              <option>Medellín</option>
              <option>Pasto</option>
              <option>Pereira</option>
              <option>Tunja</option>
              <option>Villavicencio</option>
            </select>
            <select name="workshop" id="cita-workshop" class="pv-input" required disabled>
              <option value="">Selecciona primero una ciudad</option>
            </select>
          </div>
          <div class="grid grid-cols-3 gap-3 mb-3">
            <input type="text" name="model" class="pv-input" placeholder="Modelo" required />
            <input type="number" name="model_year" class="pv-input" placeholder="Año" min="1990" max="2030" required />
            <input type="number" name="kilometraje" class="pv-input" placeholder="Kilometraje" min="0" required />
          </div>
          <div class="mb-3">
            <select name="service_type" class="pv-input" required>
              <option value="">Tipo de servicio</option>
              <option>Colisión</option>
              <option>Servicio express</option>
              <option>Reparaciones mecánicas</option>
              <option>Mantenimiento preventivo</option>
              <option>Recall</option>
              <option>Garantía</option>
            </select>
          </div>
          <textarea name="comments" rows="3" class="pv-input !h-auto py-3 mb-2" placeholder="Comentarios"></textarea>
          <PrivacyConsent id="cita-privacy" variant="dark" />
          <button type="submit" class="btn-primary w-full">Agendar Cita</button>
        </form>
      </div>

      <!-- Pregunta Repuestos -->
      <div class="bg-white/5 border border-white/10 rounded-lg p-8" data-reveal="fade-right">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center shrink-0 border border-white/20">
            <!-- lucide:package-search -->
            <svg class="w-5 h-5 text-[#da281c]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0"/><path d="m7.5 4.27 9 5.15"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/><circle cx="18.5" cy="15.5" r="2.5"/><path d="M20.27 17.27 22 19"/></svg>
          </div>
          <div>
            <h3 class="text-[18px] font-bold text-white uppercase leading-tight">Pregunta tus repuestos</h3>
            <p class="text-[12px] text-white/50">Consulta disponibilidad y cotización</p>
          </div>
        </div>
        <form class="posventa-form" data-form="repuestos">
          <input type="tel" name="phone" class="pv-input mb-3" placeholder="Número de teléfono" required />
          <div class="grid grid-cols-2 gap-3 mb-3">
            <select name="document_type" class="pv-input" required>
              <option value="">Tipo de documento</option>
              <option value="CC">Cédula de ciudadanía</option>
              <option value="CE">Cédula de extranjería</option>
              <option value="NIT">NIT</option>
              <option value="PA">Pasaporte</option>
            </select>
            <input type="text" name="document_number" class="pv-input" placeholder="Documento de identidad" required />
          </div>
          <div class="mb-3">
            <select name="city" class="pv-input" required>
              <option value="">Ciudad</option>
              <option>Barranquilla</option>
              <option>Bogotá</option>
              <option>Bucaramanga</option>
              <option>Cali</option>
              <option>Cartagena</option>
              <option>Chía</option>
              <option>Cúcuta</option>
              <option>Medellín</option>
              <option>Pasto</option>
              <option>Pereira</option>
              <option>Tunja</option>
              <option>Villavicencio</option>
            </select>
          </div>
          <div class="grid grid-cols-2 gap-3 mb-3">
            <input type="text" name="model" class="pv-input" placeholder="Modelo" required />
            <input type="number" name="model_year" class="pv-input" placeholder="Año modelo" min="1990" max="2030" required />
          </div>
          <div class="mb-3">
            <select name="part_category" class="pv-input" required>
              <option value="">¿Qué repuesto desea cotizar?</option>
              <option>Componentes de cabina</option>
              <option>Componentes eléctricos</option>
              <option>Refrigerantes</option>
              <option>Sistema de suspensión</option>
              <option>Tren de potencia</option>
              <option>Otros</option>
            </select>
          </div>
          <textarea name="message" rows="3" class="pv-input !h-auto py-3 mb-2" placeholder="Mensaje"></textarea>
          <PrivacyConsent id="repuestos-privacy" variant="dark" />
          <button type="submit" class="btn-outline w-full">Solicitar Repuesto</button>
        </form>
      </div>

    </div>

  </div>
</section>

<style>
  .pv-input {
    width: 100%;
    height: 44px;
    padding: 0 14px;
    font-family: var(--font-sans);
    font-size: 14px;
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .pv-input::placeholder { color: rgba(255, 255, 255, 0.35); }
  .pv-input:focus {
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.1);
  }
  select.pv-input {
    appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8' fill='none' stroke='%23ffffff' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='1 1 6 6 11 1'/%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 14px center;
    padding-right: 38px;
  }
  select.pv-input option { background: #1a1a1a; color: #fff; }
  select.pv-input:disabled { opacity: 0.45; cursor: not-allowed; }
  textarea.pv-input { line-height: 1.5; }
</style>

<script>
  import TomSelect from 'tom-select';
  import { submitForm } from './form-handler';
  import type { FormType } from './form-handler';

  const TS_OPTS = { create: false, allowEmptyOption: true, maxOptions: 50 };

  // City → workshops mapping
  const workshopsByCity: Record<string, string[]> = {
    'Barranquilla':  ['Country Trucks'],
    'Bogotá':        ['Inchcape Retail Américas (antes Praco Didacol)', 'Inchcape Retail Fontibón (antes Praco Didacol)', 'Truck Nation', 'Sanautos Paloquemao'],
    'Bucaramanga':   ['Vehidiesel', 'Sanautos'],
    'Cali':          ['Autama Motor', 'Pacífico Motors (Yumbo)'],
    'Cartagena':     ['Vehidiesel'],
    'Chía':          ['Alcalá Motor', 'Inchcape Retail Chía (antes Praco Didacol)'],
    'Cúcuta':        ['Fersautos'],
    'Medellín':      ['Truck Nation Itagüí'],
    'Pasto':         ['Motor K'],
    'Pereira':       ['Andinautos'],
    'Tunja':         ['Country Trucks'],
    'Villavicencio': ['Alcalá'],
  };

  // Init Tom Select on every select in the posventa forms
  const tsMap = new Map<string, InstanceType<typeof TomSelect>>();
  document.querySelectorAll<HTMLSelectElement>('form.posventa-form select').forEach((el) => {
    const ts = new TomSelect(el, { ...TS_OPTS });
    if (el.id) tsMap.set(el.id, ts);
    else tsMap.set(`${el.closest('form')?.dataset.form}-${el.name}`, ts);
  });

  // Workshop select starts disabled
  const workshopTs = tsMap.get('cita-workshop');
  if (workshopTs) workshopTs.disable();

  // City → workshop conditional logic
  const cityTs = tsMap.get('cita-city');
  if (cityTs && workshopTs) {
    cityTs.on('change', (value: string) => {
      workshopTs.clear(true);
      workshopTs.clearOptions();
      const workshops = workshopsByCity[value] ?? [];
      if (!value || workshops.length === 0) {
        workshopTs.addOption({ value: '', text: 'Selecciona primero una ciudad' });
        workshopTs.setValue('', true);
        workshopTs.disable();
        return;
      }
      workshopTs.enable();
      if (workshops.length > 1) {
        workshopTs.addOption({ value: '', text: 'Selecciona un taller' });
        workshops.forEach(w => workshopTs.addOption({ value: w, text: w }));
        workshopTs.setValue('', true);
      } else {
        workshopTs.addOption({ value: workshops[0], text: workshops[0] });
        workshopTs.setValue(workshops[0], true);
      }
    });
  }

  // Form submissions
  document.querySelectorAll<HTMLFormElement>('form.posventa-form').forEach((form) => {
    const formType = form.dataset.form as FormType;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!btn) return;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      await submitForm(form, formType, btn);
    });
  });
</script>
